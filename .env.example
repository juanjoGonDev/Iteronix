# Iteronix environment configuration.
#
# Copy this file to `.env` at the repository root (`cp .env.example .env`).
# Docker Compose reads it automatically, and the server both through Compose and
# through `pnpm dev` / `pnpm start` loads it with dotenv.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=iteronix
POSTGRES_USER=iteronix
POSTGRES_PASSWORD=change-me-in-production

# Used by the server and by `pnpm db:migrate` / `pnpm db:verify`.
# Inside Docker Compose the host is the `postgres` service; outside it, localhost.
DATABASE_URL=postgresql://iteronix:change-me-in-production@localhost:5432/iteronix

# --- HTTP ---------------------------------------------------------------------
# Host port for the web UI and API when running through Docker Compose.
ITERONIX_HTTP_PORT=4000

# Optional. The browser UI never sends a bearer token: it signs in with the
# administrator credentials below and then uses its session cookie, so internal
# routes work without any token. Set AUTH_TOKEN only for programmatic callers
# (scripts, automation) that must authorize with `Authorization: Bearer <token>`.
# AUTH_TOKEN=

# Browser origins allowed to send an IDE session to the API. Keep this in sync
# with the URL you open in the browser. Add your own host/port if you change
# ITERONIX_HTTP_PORT or expose the app on the network.
IDE_UI_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# --- Administrator account ----------------------------------------------------
# Created (or updated) at startup. If you do not edit these values the account
# is admin@admin / admin, which is fine for a local install and MUST be changed
# before exposing the app to any network.
ITERONIX_ADMIN_EMAIL=admin@admin
ITERONIX_ADMIN_PASSWORD=admin

# --- Optional ----------------------------------------------------------------
# Server bind address and port inside the process.
HOST=0.0.0.0
# 4001 for `pnpm dev`, because the web UI already serves on 4000 and the browser
# maps localhost:4000 to the API on localhost:4001. Docker Compose does not read
# this value: the container always listens on 4000 and is published on
# ITERONIX_HTTP_PORT.
PORT=4001

# Plugin registry allowlist. Comma-separated, dot-separated lowercase keys.
# "reference.echo" is always trusted; these entries additionally allow server-side plugin
# manifests to be registered from Assets > Server plugins (code and entrypoints stay server-side).
# ITERONIX_TRUSTED_PLUGIN_IDS=acme.knowledge,acme.batch-exporter

# MCP servers as a JSON array. Endpoints must use HTTPS, or HTTP on loopback.
# MCP_SERVERS=[{"serverId":"reference-knowledge","endpoint":"https://mcp.example.test/invoke","token":"server-only-token","allowedToolIds":["knowledge.query"]}]

# Integration tests must never point at DATABASE_URL.
# TEST_DATABASE_URL=postgresql://iteronix_test:password@localhost:5432/iteronix_test
